{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rardar.local/contracts/trending-discover-artifact.schema.json",
  "title": "Rardar audited near-real-time GitHub discovery artifact v1/v2/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "discoverGenerationId",
    "generatedAt",
    "latestCaptureId",
    "latestCaptureScheduledAt",
    "latestCaptureCapturedAt",
    "sourceWindowStart",
    "sourceWindowEnd",
    "sourceCaptureCount",
    "todayExplosionGenerationId",
    "todayExplosionDigest",
    "updateCadenceMinutes",
    "sortingPolicy",
    "stages",
    "coverage",
    "conflicts",
    "sourceInventory",
    "todayExplosionSource",
    "payloadDigest"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2, 3] },
    "policyVersion": { "enum": ["trending-discover-v1", "trending-discover-v2", "trending-discover-v3"] },
    "discoverGenerationId": { "$ref": "#/$defs/generationId" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "latestCaptureId": { "$ref": "#/$defs/captureId" },
    "latestCaptureScheduledAt": { "type": "string", "format": "date-time" },
    "latestCaptureCapturedAt": { "type": "string", "format": "date-time" },
    "sourceWindowStart": { "type": "string", "format": "date-time" },
    "sourceWindowEnd": { "type": "string", "format": "date-time" },
    "sourceCaptureCount": { "type": "integer", "minimum": 1, "maximum": 14 },
    "todayExplosionGenerationId": { "$ref": "#/$defs/generationId" },
    "todayExplosionDigest": { "$ref": "#/$defs/sha256" },
    "updateCadenceMinutes": { "const": 120 },
    "sortingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "withinStage"],
      "properties": {
        "sections": {
          "type": "array",
          "items": { "enum": ["just_discovered", "outside_today_momentum", "rising", "near_validation"] },
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 4
        },
        "withinStage": {
          "type": "array",
          "prefixItems": [
            { "const": "observedStarDelta DESC" },
            { "const": "totalStars DESC" },
            { "const": "repository ASC" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["justDiscovered", "rising", "nearValidation"],
      "properties": {
        "justDiscovered": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/item" } },
        "outsideTodayMomentum": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/item" } },
        "rising": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/item" } },
        "nearValidation": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "querySuccessCount",
        "queryFailureCount",
        "metadataFailureCount",
        "sourceCaptureCount",
        "candidateCount",
        "publishedCount",
        "conflictCount"
      ],
      "properties": {
        "state": { "enum": ["healthy", "degraded"] },
        "querySuccessCount": { "type": "integer", "minimum": 1, "maximum": 9 },
        "queryFailureCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "metadataFailureCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "sourceCaptureCount": { "type": "integer", "minimum": 1, "maximum": 14 },
        "candidateCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "publishedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "conflictCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "excludedExactCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "todayExactCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "todayPublishedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "excludedPublishedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "exactOutsidePublishedEvaluatedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "preExactEvaluatedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "invalidCount": { "type": "integer", "minimum": 0, "maximum": 500 }
      }
    },
    "conflicts": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/conflict" } },
    "sourceInventory": { "type": "array", "minItems": 1, "maxItems": 14, "items": { "$ref": "#/$defs/sourceCapture" } },
    "todayExplosionSource": { "$ref": "#/$defs/todaySource" },
    "signalPolicy": { "$ref": "#/$defs/signalPolicy" },
    "suppressionSummary": { "oneOf": [{ "$ref": "#/$defs/suppressionSummaryV2" }, { "$ref": "#/$defs/suppressionSummaryV3" }] },
    "todayExactCount": { "type": "integer", "minimum": 0, "maximum": 500 },
    "todayPublishedTopCount": { "const": 20 },
    "todayPublishedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
    "todayPublishedSetDigest": { "$ref": "#/$defs/sha256" },
    "excludedPublishedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
    "exactOutsidePublishedEvaluatedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
    "preExactEvaluatedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
    "eligibilityCounts": { "$ref": "#/$defs/eligibilityCounts" },
    "payloadDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "policyVersion": { "const": "trending-discover-v1" } } },
      "then": {
        "properties": {
          "schemaVersion": { "const": 1 },
          "coverage": { "required": ["excludedExactCount"] },
          "stages": { "not": { "required": ["outsideTodayMomentum"] } },
          "sourceInventory": { "items": { "required": ["generationRelativePath"] } }
        }
      },
      "else": {
        "if": { "properties": { "policyVersion": { "const": "trending-discover-v2" } } },
        "then": {
          "required": ["signalPolicy", "suppressionSummary"],
          "properties": {
            "schemaVersion": { "const": 2 },
            "coverage": { "required": ["excludedExactCount"] },
            "suppressionSummary": { "$ref": "#/$defs/suppressionSummaryV2" },
            "sourceInventory": { "items": { "required": ["generationRelativePath"] } },
            "stages": {
              "not": { "required": ["outsideTodayMomentum"] },
              "properties": {
                "justDiscovered": { "items": { "$ref": "#/$defs/itemV2" } },
                "rising": { "items": { "$ref": "#/$defs/itemV2" } },
                "nearValidation": { "items": { "$ref": "#/$defs/itemV2" } }
              }
            }
          }
        },
        "else": {
          "required": [
            "signalPolicy",
            "suppressionSummary",
            "todayExactCount",
            "todayPublishedTopCount",
            "todayPublishedCount",
            "todayPublishedSetDigest",
            "excludedPublishedCount",
            "exactOutsidePublishedEvaluatedCount",
            "preExactEvaluatedCount",
            "eligibilityCounts"
          ],
          "properties": {
            "schemaVersion": { "const": 3 },
            "signalPolicy": {
              "required": [
                "todayPublishedTopCount",
                "outsideRecentWindowHours",
                "outsideRequiresAcceleration"
              ]
            },
            "coverage": {
              "required": [
                "todayExactCount",
                "todayPublishedCount",
                "excludedPublishedCount",
                "exactOutsidePublishedEvaluatedCount",
                "preExactEvaluatedCount",
                "invalidCount"
              ]
            },
            "suppressionSummary": { "$ref": "#/$defs/suppressionSummaryV3" },
            "sourceInventory": {
              "items": { "not": { "required": ["generationRelativePath"] } }
            },
            "stages": {
              "required": ["outsideTodayMomentum"],
              "properties": {
                "justDiscovered": { "items": { "$ref": "#/$defs/itemV3" } },
                "outsideTodayMomentum": { "items": { "$ref": "#/$defs/itemV3" } },
                "rising": { "items": { "$ref": "#/$defs/itemV3" } },
                "nearValidation": { "items": { "$ref": "#/$defs/itemV3" } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "captureId": { "type": "string", "pattern": "^trending-v1-[0-9]{8}T[0-9]{6}Z$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "format": "repository",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "nullableString": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 2048 }
      ]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureId",
        "scheduledAt",
        "capturedAt",
        "coverageState",
        "originalObservationPath",
        "payloadDigestSha256",
        "fileSha256"
      ],
      "properties": {
        "captureId": { "$ref": "#/$defs/captureId" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "coverageState": { "enum": ["healthy", "degraded"] },
        "generationRelativePath": { "type": "string", "pattern": "^sources/capture-[0-9]{2}\\.json$" },
        "originalObservationPath": { "type": "string", "pattern": "^observations/trending/v1/captures/[0-9]{4}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])/trending-v1-[0-9]{8}T[0-9]{6}Z\\.json$" },
        "payloadDigestSha256": { "$ref": "#/$defs/sha256" },
        "fileSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "todaySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generationId",
        "generationManifestSha256",
        "generationManifestRelativePath",
        "generationRelativePath",
        "originalGenerationPath",
        "fileSha256",
        "windowEndedAt",
        "exactCount"
      ],
      "properties": {
        "generationId": { "$ref": "#/$defs/generationId" },
        "generationManifestSha256": { "$ref": "#/$defs/sha256" },
        "generationManifestRelativePath": { "const": "sources/today-manifest.json" },
        "generationRelativePath": { "const": "sources/today-explosion.json" },
        "originalGenerationPath": { "type": "string", "pattern": "^generations/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/trending/explosion\\.json$" },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "windowEndedAt": { "type": "string", "format": "date-time" },
        "exactCount": { "type": "integer", "minimum": 0, "maximum": 500 }
      }
    },
    "signalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absoluteGrowthGateStars",
        "relativeGrowthGatePercent",
        "consecutivePositiveIntervalGate",
        "recentDiscoveryHours",
        "nearValidationHours"
      ],
      "properties": {
        "absoluteGrowthGateStars": { "const": 10 },
        "relativeGrowthGatePercent": { "const": 1.0 },
        "consecutivePositiveIntervalGate": { "const": 2 },
        "recentDiscoveryHours": { "const": 4 },
        "nearValidationHours": { "const": 20 },
        "todayPublishedTopCount": { "const": 20 },
        "outsideRecentWindowHours": { "const": 4 },
        "outsideRequiresAcceleration": { "const": true }
      }
    },
    "suppressionSummaryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCount",
        "stageEligibleCount",
        "publishedCount",
        "suppressedWeakSignalCount",
        "suppressedExactCount",
        "conflictCount",
        "reasons"
      ],
      "properties": {
        "candidateCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "stageEligibleCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "publishedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "suppressedWeakSignalCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "suppressedExactCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "conflictCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "reasons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weak_absolute_growth",
            "weak_relative_growth",
            "no_continuous_growth",
            "already_in_today",
            "identity_conflict",
            "negative_growth",
            "disabled",
            "metadata_incomplete"
          ],
          "properties": {
            "weak_absolute_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "weak_relative_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "no_continuous_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "already_in_today": { "type": "integer", "minimum": 0, "maximum": 500 },
            "identity_conflict": { "type": "integer", "minimum": 0, "maximum": 500 },
            "negative_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "disabled": { "type": "integer", "minimum": 0, "maximum": 500 },
            "metadata_incomplete": { "type": "integer", "minimum": 0, "maximum": 500 }
          }
        }
      }
    },
    "suppressionSummaryV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCount",
        "publishedCount",
        "suppressedSignalCount",
        "excludedPublishedCount",
        "conflictCount",
        "reasons"
      ],
      "properties": {
        "candidateCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "publishedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "suppressedSignalCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "excludedPublishedCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "conflictCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "reasons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "today_published",
            "weak_recent_absolute_growth",
            "weak_recent_relative_growth",
            "no_recent_continuous_growth",
            "no_recent_acceleration",
            "weak_pre_exact_growth",
            "already_exact_without_momentum",
            "identity_conflict",
            "negative_growth",
            "disabled",
            "metadata_incomplete"
          ],
          "properties": {
            "today_published": { "type": "integer", "minimum": 0, "maximum": 20 },
            "weak_recent_absolute_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "weak_recent_relative_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "no_recent_continuous_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "no_recent_acceleration": { "type": "integer", "minimum": 0, "maximum": 500 },
            "weak_pre_exact_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "already_exact_without_momentum": { "type": "integer", "minimum": 0, "maximum": 500 },
            "identity_conflict": { "type": "integer", "minimum": 0, "maximum": 500 },
            "negative_growth": { "type": "integer", "minimum": 0, "maximum": 500 },
            "disabled": { "type": "integer", "minimum": 0, "maximum": 500 },
            "metadata_incomplete": { "type": "integer", "minimum": 0, "maximum": 500 }
          }
        }
      }
    },
    "eligibilityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["todayPublished", "exactOutsidePublished", "preExact", "invalid"],
      "properties": {
        "todayPublished": { "type": "integer", "minimum": 0, "maximum": 20 },
        "exactOutsidePublished": { "type": "integer", "minimum": 0, "maximum": 500 },
        "preExact": { "type": "integer", "minimum": 0, "maximum": 500 },
        "invalid": { "type": "integer", "minimum": 0, "maximum": 500 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubRepositoryId",
        "repository",
        "url",
        "stage",
        "firstSeenAt",
        "lastObservedAt",
        "observedWindowStart",
        "observedWindowEnd",
        "observedWindowHours",
        "observedStarDelta",
        "totalStars",
        "captureCount",
        "consecutiveCaptureCount",
        "language",
        "topics",
        "license",
        "isFork",
        "isArchived",
        "isDisabled",
        "latestPushAt",
        "sourceCaptureIds",
        "sourceEvidenceDigest"
      ],
      "properties": {
        "githubRepositoryId": { "type": "integer", "minimum": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "url": { "type": "string", "format": "http-url", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "stage": { "enum": ["just_discovered", "outside_today_momentum", "rising", "near_validation"] },
        "firstSeenAt": { "type": "string", "format": "date-time" },
        "lastObservedAt": { "type": "string", "format": "date-time" },
        "observedWindowStart": { "type": "string", "format": "date-time" },
        "observedWindowEnd": { "type": "string", "format": "date-time" },
        "observedWindowHours": { "type": "number", "minimum": 0, "maximum": 27 },
        "observedStarDelta": { "type": "integer", "minimum": 0 },
        "totalStars": { "type": "integer", "minimum": 0 },
        "captureCount": { "type": "integer", "minimum": 1, "maximum": 14 },
        "consecutiveCaptureCount": { "type": "integer", "minimum": 1, "maximum": 14 },
        "language": { "$ref": "#/$defs/nullableString" },
        "topics": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "license": { "$ref": "#/$defs/nullableString" },
        "isFork": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "isDisabled": { "const": false },
        "latestPushAt": { "type": "string", "format": "date-time" },
        "sourceCaptureIds": { "type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": { "$ref": "#/$defs/captureId" } },
        "sourceEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "relativeGrowthPercent": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 }
          ]
        },
        "positiveIntervalCount": { "type": "integer", "minimum": 0, "maximum": 13 },
        "consecutivePositiveIntervalCount": { "type": "integer", "minimum": 0, "maximum": 13 },
        "latestIntervalDelta": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer" }
          ]
        },
        "publishReasonCodes": { "$ref": "#/$defs/signalFacts" },
        "signalFacts": { "$ref": "#/$defs/signalFacts" },
        "eligibilityClass": { "enum": ["pre_exact", "exact_outside_published"] },
        "todayExactRank": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 21, "maximum": 500 }] },
        "todayExact24hDelta": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "recentWindowHours": { "type": "number", "minimum": 0, "maximum": 4 },
        "recentObservedStarDelta": { "oneOf": [{ "type": "null" }, { "type": "integer" }] },
        "priorComparableWindowDelta": { "oneOf": [{ "type": "null" }, { "type": "integer" }] },
        "accelerationDelta": { "oneOf": [{ "type": "null" }, { "type": "integer" }] },
        "recentRelativeGrowthPercent": { "oneOf": [{ "type": "null" }, { "type": "number" }] }
      }
    },
    "itemV2": {
      "allOf": [
        { "$ref": "#/$defs/item" },
        {
          "required": [
            "relativeGrowthPercent",
            "positiveIntervalCount",
            "consecutivePositiveIntervalCount",
            "latestIntervalDelta",
            "publishReasonCodes",
            "signalFacts"
          ]
        }
      ]
    },
    "itemV3": {
      "allOf": [
        { "$ref": "#/$defs/itemV2" },
        {
          "required": [
            "eligibilityClass",
            "todayExactRank",
            "todayExact24hDelta",
            "recentWindowHours",
            "recentObservedStarDelta",
            "priorComparableWindowDelta",
            "accelerationDelta",
            "recentRelativeGrowthPercent"
          ]
        }
      ]
    },
    "signalFacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "first_seen_recently",
          "outside_today_top20",
          "exact_rank_available",
          "recent_absolute_growth",
          "recent_relative_growth",
          "continuous_recent_growth",
          "recent_acceleration",
          "continuous_positive_growth",
          "absolute_growth_gate",
          "relative_growth_gate",
          "awaiting_today_settlement"
        ]
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "githubRepositoryId", "repository", "currentStars", "baselineStars", "sourceCaptureIds"],
      "properties": {
        "reason": { "enum": ["star_count_decreased", "current_disabled", "source_identity_conflict"] },
        "githubRepositoryId": { "type": "integer", "minimum": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "currentStars": { "type": "integer", "minimum": 0 },
        "baselineStars": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "sourceCaptureIds": { "type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": { "$ref": "#/$defs/captureId" } }
      }
    }
  }
}
