{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rardar.local/contracts/trending-discover-current.schema.json",
  "title": "Rardar current trending discovery pointer v1/v2/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "generationId",
    "publishedAt",
    "previousGenerationId",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2, 3] },
    "policyVersion": { "enum": ["trending-discover-v1", "trending-discover-v2", "trending-discover-v3"] },
    "generationId": { "$ref": "#/$defs/generationId" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "previousGenerationId": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/generationId" }
      ]
    },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "policyVersion": { "const": "trending-discover-v1" } } },
      "then": { "properties": { "schemaVersion": { "const": 1 } } },
      "else": {
        "if": { "properties": { "policyVersion": { "const": "trending-discover-v2" } } },
        "then": { "properties": { "schemaVersion": { "const": 2 } } },
        "else": { "properties": { "schemaVersion": { "const": 3 } } }
      }
    }
  ],
  "$defs": {
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    }
  }
}
