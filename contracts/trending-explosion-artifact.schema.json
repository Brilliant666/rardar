{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rardar.local/contracts/trending-explosion-artifact.schema.json",
  "title": "Rardar audited 24-hour GitHub explosion artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "generationId",
    "generatedAt",
    "scheduleTimezone",
    "window",
    "rankingPolicy",
    "sourceCaptures",
    "coverage",
    "exactRanked",
    "pendingRanked",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "trending-explosion-v1" },
    "generationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scheduleTimezone": { "const": "Asia/Shanghai" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "startedAt", "endedAt", "durationHours", "toleranceSeconds"],
      "properties": {
        "state": { "enum": ["exact", "warming_up", "baseline_missing"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "durationHours": { "const": 24 },
        "toleranceSeconds": { "const": 600 }
      }
    },
    "rankingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "tieBreakers", "exactLimit", "pendingLimit"],
      "properties": {
        "primary": { "const": "observedStarDelta DESC" },
        "tieBreakers": {
          "type": "array",
          "prefixItems": [
            { "const": "totalStars DESC" },
            { "const": "repository ASC" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "exactLimit": { "const": 500 },
        "pendingLimit": { "const": 500 }
      }
    },
    "sourceCaptures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "baseline", "partial", "coverageWitness"],
      "properties": {
        "current": { "$ref": "#/$defs/sourceCapture" },
        "baseline": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sourceCapture" }
          ]
        },
        "partial": {
          "type": "array",
          "maxItems": 11,
          "items": { "$ref": "#/$defs/sourceCapture" }
        },
        "coverageWitness": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sourceCapture" }
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "currentSuccessfulQueryCount",
        "currentFailedQueryCount",
        "currentMetadataFailureCount",
        "baselineSuccessfulQueryCount",
        "baselineFailedQueryCount",
        "baselineMetadataFailureCount",
        "exactEligibleCount",
        "exactPublishedCount",
        "pendingEligibleCount",
        "pendingPublishedCount",
        "conflictCount"
      ],
      "properties": {
        "state": { "enum": ["healthy", "degraded"] },
        "currentSuccessfulQueryCount": { "type": "integer", "minimum": 1, "maximum": 9 },
        "currentFailedQueryCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "currentMetadataFailureCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "baselineSuccessfulQueryCount": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 9 }
          ]
        },
        "baselineFailedQueryCount": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 8 }
          ]
        },
        "baselineMetadataFailureCount": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 500 }
          ]
        },
        "exactEligibleCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "exactPublishedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "pendingEligibleCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "pendingPublishedCount": { "type": "integer", "minimum": 0, "maximum": 500 },
        "conflictCount": { "type": "integer", "minimum": 0, "maximum": 500 }
      }
    },
    "exactRanked": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/exactItem" }
    },
    "pendingRanked": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/pendingItem" }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/conflictItem" }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "format": "repository",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "githubUrl": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "format": "http-url",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "nullableString": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 2048 }
      ]
    },
    "recallProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceKey", "sourceRank", "capturedAt"],
      "properties": {
        "source": { "enum": ["github_search", "recent_observation_carry_forward"] },
        "sourceKey": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sourceRank": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "queryId": { "type": "string", "pattern": "^query-[0-9]{2}$" },
        "query": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "page": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "github_search" } }, "required": ["source"] },
          "then": { "required": ["queryId", "query", "page"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["queryId"] },
                { "required": ["query"] },
                { "required": ["page"] }
              ]
            }
          }
        }
      ]
    },
    "sourceCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureId",
        "scheduledAt",
        "capturedAt",
        "coverageState",
        "generationRelativePath",
        "originalObservationPath",
        "payloadDigestSha256",
        "fileSha256"
      ],
      "properties": {
        "captureId": { "type": "string", "pattern": "^trending-v1-[0-9]{8}T[0-9]{6}Z$" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "coverageState": { "enum": ["healthy", "degraded"] },
        "generationRelativePath": {
          "type": "string",
          "pattern": "^trending/sources/(?:current|baseline|coverage-witness|partial-[0-9]{2})\\.json$"
        },
        "originalObservationPath": {
          "type": "string",
          "pattern": "^observations/trending/v1/captures/[0-9]{4}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])/trending-v1-[0-9]{8}T[0-9]{6}Z\\.json$"
        },
        "payloadDigestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "exactItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "githubRepositoryId",
        "repository",
        "previousRepository",
        "htmlUrl",
        "totalStars",
        "baselineStars",
        "observedStarDelta",
        "windowStartedAt",
        "windowEndedAt",
        "currentCapturedAt",
        "baselineCapturedAt",
        "createdAt",
        "updatedAt",
        "pushedAt",
        "defaultBranch",
        "primaryLanguage",
        "topics",
        "licenseSpdxId",
        "archived",
        "disabled",
        "fork",
        "mirrorUrl",
        "currentRecalledBy",
        "baselineRecalledBy",
        "state"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 500 },
        "githubRepositoryId": { "type": "integer", "minimum": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "previousRepository": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/repository" }
          ]
        },
        "htmlUrl": { "$ref": "#/$defs/githubUrl" },
        "totalStars": { "type": "integer", "minimum": 0 },
        "baselineStars": { "type": "integer", "minimum": 0 },
        "observedStarDelta": { "type": "integer", "minimum": 0 },
        "windowStartedAt": { "type": "string", "format": "date-time" },
        "windowEndedAt": { "type": "string", "format": "date-time" },
        "currentCapturedAt": { "type": "string", "format": "date-time" },
        "baselineCapturedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "pushedAt": { "type": "string", "format": "date-time" },
        "defaultBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "primaryLanguage": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 100 }
          ]
        },
        "topics": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "licenseSpdxId": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 100 }
          ]
        },
        "archived": { "type": "boolean" },
        "disabled": { "const": false },
        "fork": { "type": "boolean" },
        "mirrorUrl": { "$ref": "#/$defs/nullableString" },
        "currentRecalledBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/recallProvenance" }
        },
        "baselineRecalledBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/recallProvenance" }
        },
        "state": { "const": "exact_window" }
      }
    },
    "pendingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pendingRank",
        "pendingReason",
        "githubRepositoryId",
        "repository",
        "htmlUrl",
        "totalStars",
        "firstSeenAt",
        "observedWindowStartedAt",
        "observedWindowEndedAt",
        "observedWindowHours",
        "observedWindowStarDelta",
        "currentCapturedAt",
        "firstObservationCaptureId",
        "pushedAt",
        "primaryLanguage",
        "topics",
        "archived",
        "fork",
        "mirrorUrl",
        "currentRecalledBy"
      ],
      "properties": {
        "pendingRank": { "type": "integer", "minimum": 1, "maximum": 500 },
        "pendingReason": { "enum": ["first_seen", "baseline_missing", "baseline_ineligible"] },
        "githubRepositoryId": { "type": "integer", "minimum": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "htmlUrl": { "$ref": "#/$defs/githubUrl" },
        "totalStars": { "type": "integer", "minimum": 0 },
        "firstSeenAt": { "type": "string", "format": "date-time" },
        "observedWindowStartedAt": { "type": "string", "format": "date-time" },
        "observedWindowEndedAt": { "type": "string", "format": "date-time" },
        "observedWindowHours": {
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0, "maximum": 24 }
          ]
        },
        "observedWindowStarDelta": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer" }
          ]
        },
        "currentCapturedAt": { "type": "string", "format": "date-time" },
        "firstObservationCaptureId": { "type": "string", "pattern": "^trending-v1-[0-9]{8}T[0-9]{6}Z$" },
        "pushedAt": { "type": "string", "format": "date-time" },
        "primaryLanguage": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 100 }
          ]
        },
        "topics": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "archived": { "type": "boolean" },
        "fork": { "type": "boolean" },
        "mirrorUrl": { "$ref": "#/$defs/nullableString" },
        "currentRecalledBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/recallProvenance" }
        }
      }
    },
    "conflictItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "githubRepositoryId",
        "repository",
        "currentStars",
        "baselineStars",
        "sourceCaptureIds"
      ],
      "properties": {
        "reason": {
          "enum": [
            "star_count_decreased",
            "current_disabled",
            "source_identity_conflict",
            "source_capture_mismatch",
            "unsupported_state"
          ]
        },
        "githubRepositoryId": { "type": "integer", "minimum": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "currentStars": { "type": "integer", "minimum": 0 },
        "baselineStars": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "sourceCaptureIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^trending-v1-[0-9]{8}T[0-9]{6}Z$" }
        }
      }
    }
  }
}
