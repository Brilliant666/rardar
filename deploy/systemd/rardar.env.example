# Copy to /etc/rardar/rardar.env and keep it owned by root with mode 0640.
# All directories must exist before `pipeline.deployment check`; the checker
# never creates or repairs deployment state. RARDAR_HOME may be the final
# atomic `current` symlink; its target and every ancestor must be trustworthy.
RARDAR_HOME=/opt/rardar/current
RARDAR_DATA_DIR=/var/lib/rardar/data
RARDAR_RUNTIME_DIR=/var/lib/rardar/runtime
RARDAR_VINEXT_STATE_DIR=/var/lib/rardar/vinext-state
RARDAR_DATA_LOCK_DIR=/var/lib/rardar/locks
RARDAR_VITE_CACHE_DIR=/var/cache/rardar/vite
RARDAR_BACKUP_DIR=/var/backups/rardar

RARDAR_NODE=/usr/bin/node
RARDAR_PYTHON=/opt/rardar/current/.venv/bin/python
RARDAR_DEPLOY_MIN_FREE_BYTES=1073741824

# Both listeners remain loopback-only. Reach the website through an explicitly
# configured private tunnel or authenticated reverse proxy; never expose 3000
# or 3002 directly to the public Internet.
RARDAR_VINEXT_PORT=3000
RARDAR_RUNTIME_STATUS_PORT=3002

# Optional exact public hostnames accepted by Vite when traffic arrives
# through a reviewed reverse proxy. Use explicit FQDNs only; never use
# wildcards or true.
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=rardar.cosflow.icu

RARDAR_SCHEDULE_AT=08:00
RARDAR_SCHEDULE_TIMEZONE=Asia/Shanghai
RARDAR_STALE_AFTER_HOURS=36
RARDAR_TRENDING_PRODUCER_ENABLED=false
# Discover is an independent, explicit opt-in. Production remains false until
# a separate activation review approves it.
RARDAR_TRENDING_DISCOVER_ENABLED=false

# Retention is opt-in because apply deletes only digest-bound, audited targets.
RARDAR_RETENTION_ENABLED=false
RARDAR_RETENTION_CAPTURE_DAYS=90
RARDAR_RETENTION_GENERATION_DAYS=30
RARDAR_RETENTION_CANDIDATE_DAYS=7
RARDAR_RETENTION_TEMP_HOURS=24
RARDAR_STORAGE_WARNING_PERCENT=85
RARDAR_STORAGE_HARD_PERCENT=90
RARDAR_STORAGE_MINIMUM_FREE_BYTES=8589934592

WRANGLER_WRITE_LOGS=false
WRANGLER_LOG_PATH=/var/log/rardar/wrangler
WRANGLER_REGISTRY_PATH=/var/lib/rardar/runtime/wrangler-registry
MINIFLARE_REGISTRY_PATH=/var/lib/rardar/runtime/miniflare-registry

# Store real credentials only in /etc/rardar/rardar.secret (mode 0600), for
# example a GITHUB_TOKEN=... line when the trending Producer is enabled.
# GITHUB_TOKEN is passed only to the Scheduler child, never the Website.
# Never commit that secret file.
